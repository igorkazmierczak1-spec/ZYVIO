{
  "expo": {
    "name": "ZYVIO",
    "slug": "vybe-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/zyvio-icon.png",
    "scheme": "vybe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.zyvio.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/zyvio-icon.png",
        "backgroundColor": "#16131f"
      }
    },
    "splash": {
      "image": "./assets/images/zyvio-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f5f8"
    },
    "web": {
      "favicon": "./assets/images/zyvio-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
